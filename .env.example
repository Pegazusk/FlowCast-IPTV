# PostgreSQL: la contraseña es la que usaste en db/00_crear_base.sql.
URL_BASE_DATOS=postgresql+psycopg://flowcast:CONTRASENA_DE_POSTGRES@localhost:5432/flowcast

# Firma de los tokens de sesión (mínimo 32 caracteres).
# Genera una con: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=

# Cifra las credenciales de los proveedores en la base (clave Fernet de 44 caracteres).
# Genera una con: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO=

MINUTOS_TOKEN_ACCESO=15
DIAS_TOKEN_REFRESCO=30

# Proveedor Xtream que recibe cada cuenta nueva al registrarse. Opcional: si se dejan vacíos,
# cada usuario registra su proveedor desde la app. Para desarrollar sin proveedor real, arranca
# tools/proveedor_simulado.py (uv run uvicorn tools.proveedor_simulado:app --host 0.0.0.0 --port 8090)
# y usa la IP de tu máquina, usuario demo y contraseña demo.
CONEXION_INICIAL_ETIQUETA=
CONEXION_INICIAL_URL=
CONEXION_INICIAL_USUARIO=
CONEXION_INICIAL_CONTRASENA=

# Carpeta con música (mp3, m4a, flac, ogg, wav) para la sección Música. Opcional.
# tools/medios/musica se genera con: uv run python tools/generar_musica.py
MUSICA_CARPETA=tools/medios/musica

# Clave de themoviedb.org para las fotos del elenco. Opcional; sin ella se muestran solo nombres.
TMDB_CLAVE_API=

# Opcionales.
NOMBRE_APP=FlowCast API
DEPURACION=false
REGISTRO_ABIERTO=false
PRECALENTAR_CATALOGO=false
DOCUMENTACION_PUBLICA=false
CONFIAR_PROXY=false
ORIGENES_PERMITIDOS=
